<script>
	{{/* before our JS code gets loaded, use arrays to store errors, then the arrays will be switched to our error handler later */}}
	window.addEventListener('error', function(e) {window._globalHandlerErrors=window._globalHandlerErrors||[]; window._globalHandlerErrors.push(e);});
	window.addEventListener('unhandledrejection', function(e) {window._globalHandlerErrors=window._globalHandlerErrors||[]; window._globalHandlerErrors.push(e);});
	window.config = {
		appUrl: '{{AppUrl}}',
		appSubUrl: '{{AppSubUrl}}',
		assetVersionEncoded: encodeURIComponent('{{AssetVersion}}'), // will be used in URL construction directly
		assetUrlPrefix: '{{AssetUrlPrefix}}',
		runModeIsProd: {{.RunModeIsProd}},
		customEmojis: new Set({{CustomEmojis}}),
		pageData: {{.PageData}},
		notificationSettings: {{NotificationSettings}}, {{/*a map provided by NewFuncMap in helper.go*/}}
		enableTimeTracking: {{EnableTimetracking}},
		{{if or .Participants .Assignees .MentionableTeams}}
		mentionValues: Array.from(new Map([
			{{- range .Participants -}}
				['{{.Name}}', {key: '{{.Name}} {{.FullName}}', value: '{{.Name}}', name: '{{.Name}}', fullname: '{{.FullName}}', avatar: '{{.AvatarLink $.Context}}'}],
			{{- end -}}
			{{- range .Assignees -}}
				['{{.Name}}', {key: '{{.Name}} {{.FullName}}', value: '{{.Name}}', name: '{{.Name}}', fullname: '{{.FullName}}', avatar: '{{.AvatarLink $.Context}}'}],
			{{- end -}}
			{{- range .MentionableTeams -}}
				['{{$.MentionableTeamsOrg}}/{{.Name}}', {key: '{{$.MentionableTeamsOrg}}/{{.Name}}', value: '{{$.MentionableTeamsOrg}}/{{.Name}}', name: '{{$.MentionableTeamsOrg}}/{{.Name}}', avatar: '{{$.MentionableTeamsOrgAvatar}}'}],
			{{- end -}}
		]).values()),
		{{end}}
		mermaidMaxSourceCharacters: {{MermaidMaxSourceCharacters}},
		{{/* this global i18n object should only contain general texts. for specialized texts, it should be provided inside the related modules by: (1) API response (2) HTML data-attribute (3) PageData */}}
		i18n: {
			copy_success: {{ctx.Locale.Tr "copy_success"}},
			copy_error: {{ctx.Locale.Tr "copy_error"}},
			error_occurred: {{ctx.Locale.Tr "error.occurred"}},
			network_error: {{ctx.Locale.Tr "error.network_error"}},
			remove_label_str: {{ctx.Locale.Tr "remove_label_str"}},
			modal_confirm: {{ctx.Locale.Tr "modal.confirm"}},
			modal_cancel: {{ctx.Locale.Tr "modal.cancel"}},
			more_items: {{ctx.Locale.Tr "more_items"}},
			incorrect_root_url: {{ctx.Locale.Tr "incorrect_root_url" AppUrl}},
			command_palette_title: {{ctx.Locale.Tr "command_palette.title"}},
			command_palette_tooltip: {{ctx.Locale.Tr "command_palette.tooltip"}},
			command_palette_placeholder: {{ctx.Locale.Tr "command_palette.placeholder"}},
			command_palette_searching: {{ctx.Locale.Tr "command_palette.searching"}},
			command_palette_no_results: {{ctx.Locale.Tr "command_palette.no_results"}},
			command_palette_recent: {{ctx.Locale.Tr "command_palette.recent"}},
			command_palette_suggested: {{ctx.Locale.Tr "command_palette.suggested"}},
			command_palette_commands: {{ctx.Locale.Tr "command_palette.commands"}},
			command_palette_repositories: {{ctx.Locale.Tr "command_palette.repositories"}},
			command_palette_users: {{ctx.Locale.Tr "command_palette.users"}},
			command_palette_repo_issues: {{ctx.Locale.Tr "command_palette.repo_issues"}},
			command_palette_hint_navigate: {{ctx.Locale.Tr "command_palette.hint_navigate"}},
			command_palette_hint_open: {{ctx.Locale.Tr "command_palette.hint_open"}},
			command_palette_hint_new_tab: {{ctx.Locale.Tr "command_palette.hint_new_tab"}},
			command_palette_hint_close: {{ctx.Locale.Tr "command_palette.hint_close"}},
			command_palette_dashboard: {{ctx.Locale.Tr "command_palette.dashboard"}},
			command_palette_issues: {{ctx.Locale.Tr "command_palette.issues"}},
			command_palette_pull_requests: {{ctx.Locale.Tr "command_palette.pull_requests"}},
			command_palette_milestones: {{ctx.Locale.Tr "command_palette.milestones"}},
			command_palette_notifications: {{ctx.Locale.Tr "command_palette.notifications"}},
			command_palette_explore_repos: {{ctx.Locale.Tr "command_palette.explore_repos"}},
			command_palette_explore_users: {{ctx.Locale.Tr "command_palette.explore_users"}},
			command_palette_explore_orgs: {{ctx.Locale.Tr "command_palette.explore_orgs"}},
			command_palette_create_repo: {{ctx.Locale.Tr "command_palette.create_repo"}},
			command_palette_new_migration: {{ctx.Locale.Tr "command_palette.new_migration"}},
			command_palette_new_org: {{ctx.Locale.Tr "command_palette.new_org"}},
			command_palette_user_settings: {{ctx.Locale.Tr "command_palette.user_settings"}},
			command_palette_site_admin: {{ctx.Locale.Tr "command_palette.site_admin"}},
			command_palette_sign_in: {{ctx.Locale.Tr "command_palette.sign_in"}},
			settings_nav_filter_placeholder: {{ctx.Locale.Tr "settings_nav.filter_placeholder"}},
			settings_nav_no_match: {{ctx.Locale.Tr "settings_nav.no_match"}},
			settings_nav_menu: {{ctx.Locale.Tr "settings_nav.menu"}},
		},
	};
	{{/* in case some pages don't render the pageData, we make sure it is an object to prevent null access */}}
	window.config.pageData = window.config.pageData || {};
</script>
<script type="module" src="{{AssetUrlPrefix}}/js/webcomponents.js?v={{AssetVersion}}"></script>
