{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content ui {{if .IsRepo}}repository{{end}}">
	{{if .IsRepo}}{{template "repo/header" .}}{{end}}
	<div class="status-page">
		<h1 class="error-code">404</h1>
		<h2 class="status-page-title">{{ctx.Locale.Tr "error404_title"}}</h2>
		<p class="status-page-text">{{if .NotFoundPrompt}}{{.NotFoundPrompt}}{{else}}{{ctx.Locale.Tr "error404"}}{{end}}</p>
		<div class="status-page-actions">
			{{if .NotFoundGoBackURL}}<a class="ui primary button" href="{{.NotFoundGoBackURL}}">{{ctx.Locale.Tr "go_back"}}</a>{{end}}
			<a class="ui button" href="{{AppSubUrl}}/">{{ctx.Locale.Tr "home"}}</a>
			{{if .IsSigned}}{{else}}<a class="ui button" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>{{end}}
		</div>
		{{if .ShowFooterVersion}}<p class="status-page-version">{{ctx.Locale.Tr "admin.config.app_ver"}}: {{AppVerNoMetadata}}</p>{{end}}
	</div>
</div>
{{template "base/footer" .}}
