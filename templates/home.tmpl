{{template "base/head" .}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home"}}{{end}}" class="page-content home blacksmith-landing">
	<div class="blacksmith-hero">
		<img class="mark" width="96" height="96" src="{{AssetUrlPrefix}}/img/logo.svg" alt="{{ctx.Locale.Tr "logo"}}">
		<div class="wordmark">Blacksmith</div>
		<p class="tagline">{{ctx.Locale.Tr "startpage.app_desc"}}</p>
		<div class="actions">
			<a class="ui primary button" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "sign_in"}}</a>
			{{if .ShowRegistrationButton}}
				<a class="ui basic button" href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "register"}}</a>
			{{end}}
		</div>
	</div>
	{{template "home_blacksmith" .}}
</div>
{{template "base/footer" .}}
