# Blacksmith production environment.
# Copy to .env next to compose.prod.yaml.

# Public hostname. The proxy serves plain HTTP on ${HTTP_PORT} by default;
# put TLS termination in front or enable Caddy auto_https in the Caddyfile.
BLACKSMITH_DOMAIN=forge.example.com
SSH_DOMAIN=forge.example.com
ROOT_URL=https://forge.example.com/

HTTP_PORT=80
HTTPS_PORT=443
SSH_PORT=2222

# Generate once with:
#   podman run --rm crowdsecurity/crowdsec cscli bouncers add blacksmith
# or just set any long random string and keep it identical on both sides.
CROWDSEC_BOUNCER_KEY=change-me-to-a-long-random-string

# sqlite3 by default. For postgres enable the 'db' profile:
#   --profile db
# and set these:
DB_TYPE=sqlite3
DB_HOST=postgres:5432
DB_NAME=blacksmith
DB_USER=blacksmith
DB_PASSWD=change-me

DISABLE_REGISTRATION=true
INSTALL_LOCK=false

# Backups (profile: backup). Encrypted restic repo, rest-server or s3.
# RESTIC_REPOSITORY=rest:https://rest.example.com/blacksmith/
# RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/bucket/blacksmith
RESTIC_REPOSITORY=
RESTIC_PASSWORD=change-me-to-a-long-random-string
BACKUP_INTERVAL=86400
RESTIC_FORGET_ARGS=--keep-daily 7 --keep-weekly 4 --keep-monthly 6

# S3 credentials when RESTIC_REPOSITORY=s3:...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Auto-update sidecar (profile: updater). Rootless podman socket:
#   systemctl --user enable --now podman.socket
CONTAINER_SOCKET=/run/user/1000/podman/podman.sock
UPDATE_INTERVAL=86400
