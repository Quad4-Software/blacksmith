# Blacksmith production environment.
# Copy to .env next to compose.prod.yaml.

# Public hostname. The proxy serves plain HTTP on ${HTTP_PORT} by default;
# put TLS termination in front or enable Caddy auto_https in the Caddyfile.
BLACKSMITH_DOMAIN=forge.example.com
SSH_DOMAIN=forge.example.com
ROOT_URL=https://forge.example.com/

HTTP_PORT=80
HTTPS_PORT=443
SSH_PORT=2222

# Generate once with:
#   podman run --rm crowdsecurity/crowdsec cscli bouncers add blacksmith
# or just set any long random string and keep it identical on both sides.
CROWDSEC_BOUNCER_KEY=change-me-to-a-long-random-string

# sqlite3 by default. For postgres enable the 'db' profile:
#   --profile db
# and set these:
DB_TYPE=sqlite3
DB_HOST=postgres:5432
DB_NAME=blacksmith
DB_USER=blacksmith
DB_PASSWD=change-me

DISABLE_REGISTRATION=true
INSTALL_LOCK=false

# Backups (profile: backup). Encrypted restic repo, rest-server or s3.
# RESTIC_REPOSITORY=rest:https://rest.example.com/blacksmith/
# RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/bucket/blacksmith
RESTIC_REPOSITORY=
RESTIC_PASSWORD=change-me-to-a-long-random-string
BACKUP_INTERVAL=86400
RESTIC_FORGET_ARGS=--keep-daily 7 --keep-weekly 4 --keep-monthly 6

# S3 credentials when RESTIC_REPOSITORY=s3:...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Auto-update sidecar (profile: updater). Whats Up Docker.
# Rootless podman socket:
#   systemctl --user enable --now podman.socket
CONTAINER_SOCKET=/run/user/1000/podman/podman.sock
UPDATE_CRON=0 3 * * *

# SSH clone endpoint. Bound to localhost by default since only
# authorized-key holders can use it anyway. Set 0.0.0.0 to expose.
SSH_BIND=127.0.0.1
SSH_PORT=2222

# Cap captcha (profile: captcha). Self-hosted trycap.dev server.
# CAP_URL is the public URL browsers reach; create a site key in
# the cap dashboard first.
ENABLE_CAPTCHA=false
CAPTCHA_TYPE=cap
CAP_URL=https://cap.quad4.io/
CAP_SITEKEY=
CAP_SECRET=
CAP_ADMIN_KEY=change-me-32-chars-minimum

# Crow CI (profile: crow). Create an OAuth2 app in Blacksmith at
# Settings -> Applications with redirect ${CROW_HOST}/authorize.
CROW_HOST=http://localhost:8000
CROW_PORT=8000
CROW_BIND=127.0.0.1
CROW_AGENT_SECRET=change-me-to-a-long-random-string
CROW_FORGEJO_CLIENT=
CROW_FORGEJO_SECRET=
CROW_MAX_WORKFLOWS=4
