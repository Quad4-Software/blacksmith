[fsck]
	missingspacebeforedate = ignore
	zeropaddedfilemode = ignore
	badtimezone = ignore
[fetch "fsck"]
	zeropaddedfilemode = ignore
	badtimezone = ignore
	missingspacebeforedate = ignore
[receive "fsck"]
	missingspacebeforedate = ignore
	zeropaddedfilemode = ignore
	badtimezone = ignore
[diff]
	algorithm = histogram
[core]
	logallrefupdates = true
	hooksPath = /run/media/user1/projects/blacksmith/.tmpdata/data/home/hooks
	quotePath = false
	commitGraph = true
[transfer]
	fsckobjects = true
[gc]
	reflogexpire = 90
	writeCommitGraph = true
[user]
	email = forgejo@fake.local
	name = Blacksmith
[receive]
	advertisePushOptions = true
	procReceiveRefs = refs/for
	procReceiveRefs = refs/pull/
[fetch]
	writeCommitGraph = true
[safe]
	directory = *
[gpg]
	format = openpgp
[uploadpack]
	allowfilter = true
	allowAnySHA1InWant = true
